NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the
# publishable key. The service-role key is used only by the guarded server-side
# team invitation action. Never add it to browser code or a NEXT_PUBLIC_* value.
